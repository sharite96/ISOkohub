<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IsokoHub Admin Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f6f8;
      color: #222;
    }

    .header {
      background: #111827;
      color: white;
      padding: 18px;
      text-align: center;
    }

    .header h1 {
      font-size: 24px;
    }

    .container {
      padding: 20px;
      max-width: 1100px;
      margin: auto;
    }

    .welcome {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .welcome h2 {
      margin-bottom: 8px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 15px;
      margin-bottom: 25px;
    }

    .card {
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .card h3 {
      font-size: 15px;
      color: #666;
      margin-bottom: 10px;
    }

    .card p {
      font-size: 28px;
      font-weight: bold;
    }

    .section {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .section h2 {
      margin-bottom: 15px;
    }

    .button {
      display: inline-block;
      padding: 12px 18px;
      margin: 5px;
      border: none;
      border-radius: 8px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      cursor: pointer;
    }

    .button:hover {
      background: #1d4ed8;
    }

    .danger {
      background: #dc2626;
    }

    .danger:hover {
      background: #b91c1c;
    }

    .footer {
      text-align: center;
      padding: 20px;
      color: #777;
    }
  </style>
</head>

<body>

  <div class="header">
    <h1>IsokoHub Admin Dashboard</h1>
  </div>

  <div class="container">

    <div class="welcome">
      <h2>Welcome, Admin 👋</h2>
      <p>Manage your IsokoHub marketplace from this dashboard.</p>
    </div>

    <div class="cards">

      <div class="card">
        <h3>Total Users</h3>
        <p>0</p>
      </div>

      <div class="card">
        <h3>Total Products</h3>
        <p>0</p>
      </div>

      <div class="card">
        <h3>Total Sellers</h3>
        <p>0</p>
      </div>

      <div class="card">
        <h3>Orders</h3>
        <p>0</p>
      </div>

    </div>

    <div class="section">
      <h2>Management</h2>

      <a href="#" class="button">Users</a>
      <a href="#" class="button">Products</a>
      <a href="#" class="button">Sellers</a>
      <a href="#" class="button">Orders</a>
      <a href="#" class="button">Messages</a>
    </div>

    <div class="section">
      <h2>Admin Actions</h2>

      <button class="button" onclick="alert('Product management coming soon')">
        Manage Products
      </button>

      <button class="button" onclick="alert('User management coming soon')">
        Manage Users
      </button>

      <button class="button danger" onclick="logout()">
        Logout
      </button>
    </div>

  </div>

  <div class="footer">
    © 2026 IsokoHub — Admin Panel
  </div>

  <script>
    function logout() {
      alert("You have been logged out.");
      window.location.href = "index.html";
    }
  </script>

</body>
</html>
